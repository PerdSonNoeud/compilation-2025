fun fact (n) =
    if n =? 0 then 1 else n * fact (n - 1) fi

fun apply(f,x) = f(x)

fun addk(k) = \(x) => x+k

fun simpleAdd(x,y) = x+y

fun curry(f) = \(x)=> \(y) => f(x,y)

fun f(x) = if x =? 0 then 1 else g(x-1) fi

and g(x) = if x =? 0 then 0 else f(x-1) fi

val main =
    print_int (curry(simpleAdd)(1)(2))


